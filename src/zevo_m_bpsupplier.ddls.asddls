@AbapCatalog.sqlViewName: 'ZEVOMBPSUPPL'
@AbapCatalog.compiler.compareFilter: true
@AccessControl.authorizationCheck: #CHECK
@EndUserText.label: 'Business Partner Supplier Role (Master Data)'
@ObjectModel.usageType: { serviceQuality: #D, sizeCategory: #XL, dataClass: #MASTER }
define view ZEVO_M_BPSupplier
  as select from I_BusinessPartnerSupplierDEX as Dex
  left outer join I_Supplier as Spl
    on Dex.Supplier = Spl.Supplier
{
  key Dex.BusinessPartner,
  key Dex.Supplier,
      Dex.BusinessPartnerUUID,
      Dex.BusinessPartnerCategory,
      Dex.SupplierAccountGroup,
      Dex.TitleSupplier,
      Dex.InternationalLocationNumber1,
      Dex.InternationalLocationNumber2,
      Dex.InternationalLocationNumber3,
      Dex.ReferenceAccountGroup,
      Dex.SupplierAlternativePayee,
      Dex.Customer,
      Dex.PostingIsBlocked,
      Dex.PurchasingIsBlocked,
      Dex.VATLiability,
      Dex.PaymentIsBlockedForSupplier,
      Dex.SuplrProofOfDelivRlvtCode,
      Dex.BR_TaxIsSplit,
      Dex.IsActiveEntity,
      Dex.AuthorizationGroup,
      Dex.IsToBeAcceptedAtOrigin,
      Dex.SupplierCorporateGroup,
      Dex.ResponsibleType,
      Dex.FiscalAddress,
      Dex.SupplierProcurementBlock,
      Dex.DataExchangeInstructionKey,
      Dex.BPIsEqualizationTaxSubject,
      Dex.BRSpcfcTaxBasePercentageCode,
      Dex.DataMediumExchangeIndicator,
      Dex.TranspServiceAgentStstcGrp,
      Dex.TaxNumberResponsible,
      Dex.TaxNumberType,
      Dex.SuplrQualityManagementSystem,
      Dex.SuplrQltyInProcmtCertfnValidTo,
      Dex.SupplierIsSubrangeRelevant,
      Dex.TrainStationName,
      Dex.AlternativePayeeIsAllowed,
      Dex.PaytSlipWthRefSubscriber,
      Dex.SupplierIsPlantRelevant,
      Dex.FactoryCalendar,
      Dex.SupplierPlant,
      Spl.TradingPartner,
      Dex.DeletionIndicator,
      Dex.IsBusinessPurposeCompleted,
      Dex.PaymentReason,
      Dex.SupplierCentralDeletionIsBlock,
      Dex.DataControllerSet,
      Dex.DataController1,
      Dex.DataController2,
      Dex.DataController3,
      Dex.DataController4,
      Dex.DataController5,
      Dex.DataController6,
      Dex.DataController7,
      Dex.DataController8,
      Dex.DataController9,
      Dex.DataController10,
      Dex.IsOneTimeAccount,
      Dex.BusinessPartnerPanNumber
}
